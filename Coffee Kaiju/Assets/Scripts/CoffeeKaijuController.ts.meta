  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">CoffeeKaijuController – mug timer kaiju state machine</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject cameraObject {"hint":"The world camera (Camera Object)"}'
    - '// @input SceneObject placeSurface {"hint":"Invisible desk-height surface that catches the first pinch"}'
    - '// @input AssignableType_1 desk {"hint":"Desk slab stand-in (CoffeeKaijuDeskUI on DeskStandIn)"}'
    - '// @input AssignableType_2 mug {"hint":"Virtual mug and its effects (CoffeeKaijuMugFX on Mug)"}'
    - '// @input AssignableType_3 ring {"hint":"Countdown ring view (CoffeeKaijuRingUI on CountdownRing)"}'
    - '// @input AssignableType_4 readyTick {"hint":"Ready tick view (CoffeeKaijuReadyTickUI on ReadyTick)"}'
    - '// @input SceneObject kaijuRoot {"hint":"Kaiju root moved by this script (child of DeskStandIn)"}'
    - '// @input SceneObject kaijuModel {"hint":"The imported CoffeeKaiju model that holds the AnimationPlayer"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float startDurationIndex = 2 {"hint":"Countdown length used until the user picks another on the ring", "widget":"combobox", "values":[{"label":"0:30 (demo)", "value":0}, {"label":"3 min", "value":1}, {"label":"5 min", "value":2}, {"label":"8 min", "value":3}]}'
    - '// @input float foamFadeStartCm = 50 {"hint":"Camera distance (cm) at which the foam starts to fade", "widget":"slider", "min":30, "max":100, "step":1}'
    - '// @input float foamClearCm = 40 {"hint":"Camera distance (cm) at which the foam is fully clear", "widget":"slider", "min":20, "max":90, "step":1}'
    - '// @input float ringDimAngleDeg = 15 {"hint":"Ring dims when the mug is more than this many degrees from the centre of view", "widget":"slider", "min":5, "max":45, "step":1}'
    - '// @input float buddySeconds = 120 {"hint":"Seconds the kaiju sits on the rim before waving off and the Lens clears", "widget":"slider", "min":10, "max":300, "step":5}'
    - '// @input float readyTickSeconds = 5 {"hint":"Seconds the Ready tick stays up", "widget":"slider", "min":1, "max":15, "step":0.5}'
    - '// @input float volume = 1 {"hint":"Volume of all sounds", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
